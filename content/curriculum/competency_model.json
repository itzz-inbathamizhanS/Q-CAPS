{
  "version": 1,
  "status": "proposed-v1",
  "description": "Skill model from Q-CAPS Curriculum Architecture v1 section 3. Every lesson objective, quiz item and practical carries exactly one primary competency id and one depth. Capability is estimated per competency from server-graded evidence only; XP plays no part.",
  "source_document": "docs/curriculum/Q-CAPS Curriculum Architecture v1.md",
  "depths": [
    {
      "id": "Aware",
      "rank": 1,
      "meaning": "recognise, name"
    },
    {
      "id": "Explain",
      "rank": 2,
      "meaning": "describe why"
    },
    {
      "id": "Apply",
      "rank": 3,
      "meaning": "use in a defined task"
    },
    {
      "id": "Analyse",
      "rank": 4,
      "meaning": "evaluate, choose, critique"
    }
  ],
  "capability_levels": {
    "status": "pilot-hypothesis",
    "note": "Thresholds are starting hypotheses to calibrate against pilot data, not validated cut scores (Architecture 3.3, O3).",
    "levels": [
      {
        "id": "Unknown",
        "rank": 0,
        "evidence": "Fewer than 3 scored items on this competency"
      },
      {
        "id": "Beginner",
        "rank": 1,
        "evidence": "At least 3 items; below 60% on Aware/Explain items"
      },
      {
        "id": "Developing",
        "rank": 2,
        "evidence": "At least 60% on Aware/Explain items"
      },
      {
        "id": "Proficient",
        "rank": 3,
        "evidence": "Developing, plus at least 70% on Apply items and one passed practical"
      },
      {
        "id": "Advanced",
        "rank": 4,
        "evidence": "Proficient, plus at least 70% on Analyse items or a passed capstone component"
      }
    ],
    "min_items_for_known": 3,
    "stale_after_months": 12,
    "min_coverage_for_domain_score": 0.5
  },
