# Shared by main_api and scanner_api (scanner validates the same JWTs). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
QCAPS_JWT_SECRET=
# development (default) | production. In production the backend refuses to start without
# QCAPS_JWT_SECRET. The secret must be at least 32 characters.
QCAPS_ENV=development
# Legacy endpoint that trusts client-reported quiz scores. Leave unset (it then returns 410).
# QCAPS_ENABLE_LEGACY_QUIZ_SUBMIT=1
QCAPS_TOKEN_EXPIRE_MINUTES=1440
QCAPS_DATABASE_URL=sqlite:///./qcaps.db
QCAPS_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Scanner limits
SCANNER_HOST=127.0.0.1
SCANNER_RATE_LIMIT=5
SCANNER_RATE_WINDOW_SECONDS=60
SCANNER_MAX_CONCURRENT=3

# Course content (admin API)
# Comma-separated hosts allowed for video blocks (exact hostnames, https only).
# Empty = no video URLs accepted.
QCAPS_VIDEO_HOST_ALLOWLIST=
# First admin: python -m course_content.cli create-admin <name>   (run from backend/main_api)
# A new admin's password is read from this variable or an interactive prompt. Never commit it.
QCAPS_ADMIN_PASSWORD=

# Sign-in attempts per (client address, user name) and window (in-memory, per process)
QCAPS_LOGIN_RATE_LIMIT=10
QCAPS_LOGIN_RATE_WINDOW_SECONDS=300

# Checkpoint attempt limit per learner and checkpoint (in-memory, per process)
QCAPS_CHECKPOINT_RATE_LIMIT=6
QCAPS_CHECKPOINT_RATE_WINDOW_SECONDS=60
