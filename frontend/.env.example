# Q-CAPS frontend environment variables. Copy to frontend/.env.local for local development.
# Only VITE_* variables are exposed to the browser, so never put a secret here.

# Main API base URL (FastAPI), including /api. Local default shown. The hosted value
# (https://qcaps-api.onrender.com/api) is set in the Vercel project settings; production builds fail without it.
VITE_API_BASE_URL=http://localhost:8000/api

# Scanner service base URL (Flask), without /api. Local default shown.
# Hosted value is set in frontend/vercel.json: https://qcaps-scanner.onrender.com
VITE_SCANNER_API_URL=http://localhost:5000
